# URL pública del sitio, sin barra final. Se usa para las URLs canónicas, las
# etiquetas Open Graph y el sitemap. Sin ella, esas URLs se emiten relativas.
VITE_SITE_URL=https://ejemplo.com

# Widget del asistente RAG. Las tres variables tienen que estar presentes para
# que el widget se cargue; si falta cualquiera, el bloque no se renderiza.
# VITE_CHAT_WIDGET_URL=https://asistente.ejemplo.com/widget.js
# VITE_CHAT_API_URL=https://asistente.ejemplo.com/api
# VITE_CHAT_TENANT_KEY=clave-del-tenant
